# Twitch app credentials — https://dev.twitch.tv/console/apps
# Register an app (OAuth redirect http://localhost, category "Application Integration")
# and paste the Client ID and a generated Client Secret here.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Chat-only mode. Chat is anonymous and unmetered, so moment detection runs
# with no credentials at all - and chat is the only signal that can fire
# BEFORE anybody has clipped. What it cannot do is measure saturation: with no
# API there is no way to count who already has a moment.
#
# Helix is the only way to ask "who is live in this category", so without it
# the channels have to be named. Unset uses a built-in starting list; set it to
# nothing at all to disable chat-only entirely.
# WATCH_CHANNELS=xqc,kaicenat,caseoh_

# Seconds between chat-only detection passes. A bucket closes every 10s and
# being first is the whole point of this path, so it polls faster than clips.
# CHAT_POLL_SECONDS=10

# Which Twitch category to watch. Resolved to an id at startup, so this is the
# only thing you change to point the whole feed at a different game.
GAME_NAME=Grand Theft Auto VI

# Optional: skip name resolution by pinning the category id directly.
GAME_ID=

# How far back to look for clips, in minutes. Shorter = fresher and cheaper,
# but moments drop off the feed sooner.
CLIP_WINDOW_MINUTES=25

# Seconds between clip polls. 30 is responsive without burning rate limit.
CLIP_POLL_SECONDS=30

# Max pages of 100 clips per poll. Raise if the feed reports truncation.
CLIP_MAX_PAGES=30

# Seconds between live-channel refreshes (also updates the chat watch list).
STREAM_POLL_SECONDS=120

# Clips within this many seconds of each other count as the same moment.
CLUSTER_GAP_SECONDS=30

# Deep links start this many seconds early, because chat reacts after the
# thing happens and so do clippers.
LEAD_IN_SECONDS=20

# How many top channels to watch chat on. Each socket carries 18 channels.
CHAT_CHANNELS=80

# Set to false to run on clip data alone (no IRC connections).
CHAT_ENABLED=true

# How loud a 10-second bucket must be before it can count as a spike. Low on
# purpose: a high floor only admits channels so big their moments are flooded
# the moment they happen, which is the opposite of what this feed is for.
CHAT_FLOOR_MESSAGES=8
CHAT_MIN_RISE=1.5
CHAT_SPIKE_Z=3


PORT=3000

# ---------- local clip extraction ----------
# Needs yt-dlp and ffmpeg on the machine:  python -m pip install yt-dlp
# (streamlink is NOT used — see the README for why it cannot work here.)

# How much of the VOD to take around a moment, in seconds. Lopsided on
# purpose: chat and clippers both react AFTER the thing happens, so the
# moment's timestamp is the tail of it and the cause sits in the pre-roll.
CLIP_PRE=25
CLIP_POST=5

# Where the mp4s land, relative to the repo. Already gitignored.
CLIP_DIR=clips

# Height cap (1080 / 720 / 480), or "source" for whatever Twitch has, or any
# yt-dlp format string if you want to be precise.
CLIP_QUALITY=1080

# Simultaneous cuts. Each one is an ffmpeg re-encode, so more than 2 just
# makes the clip someone is waiting on slower.
CLIP_CONCURRENCY=2

# How to invoke yt-dlp. The module form is the default because the console
# script shim fails on some Windows installs.
YTDLP_CMD=python -m yt_dlp

# ---------- detection store ----------
# Every moment, clip and poll is written here so outcomes can be checked hours
# later and `npm run eval` can say whether the ranking actually works.
# node:sqlite is in the Node standard library — no dependency.
STORE_ENABLED=true
STORE_PATH=data/feed.db

# How often to look back at older moments and record what became of them.
OUTCOME_POLL_SECONDS=60
OUTCOME_BATCH=20

# How long to keep the per-poll observation rows. Only those are pruned; the
# moments, clips and outcomes behind the clipper index are kept, because that
# history cannot be re-collected after the fact.
STORE_PRUNE_DAYS=14

# --- Channel automation ---------------------------------------------------
# Detects, cuts, captions and renders 9:16 shorts with no clicks. Channels and
# the on/off switch live in the page (saved to data/automation.json); this
# starts a fresh install switched on. `npm run auto` is always on.
# Each short lands here as an .mp4 plus a .txt of post copy (caption, credit,
# link, tags). Nothing is ever uploaded or posted: what you post, you post.
AUTOCLIP=off
AUTOCLIP_DIR=clips/ready
# The real control knob: how many shorts an hour, overall and per channel.
AUTOCLIP_PER_HOUR=6
AUTOCLIP_PER_CHANNEL_PER_HOUR=2
AUTOCLIP_MAX_PER_POLL=2
# Feed states worth cutting. A flooded moment is already on everyone's feed.
AUTOCLIP_STATES=early,fresh
# 0 on purpose. The opportunity scale is uncalibrated until `npm run eval`
# has enough outcomes to say what a good score is; a threshold before then
# would be a guess dressed as a setting.
AUTOCLIP_MIN_SCORE=0
# Wait this long after the cut window ends before cutting. Measured: a live,
# still-recording archive held full footage 15s behind the live edge.
AUTOCLIP_SETTLE_SECONDS=30
# Older than this and someone else has had time to post it.
AUTOCLIP_MAX_AGE_MINUTES=20
# Two moments this close on the same VOD are the same moment.
AUTOCLIP_DEDUPE_SECONDS=45

# reel: black canvas, white hook directly on top of the picture (the default).
# blur: a blurred copy of the frame fills the canvas, outlined caption above.
SHORTS_STYLE=reel
# Caption font (.ttf). Empty = Segoe UI Bold (reel) or Black (blur) on Windows,
# DejaVu Sans Bold elsewhere.
SHORTS_FONT=
SHORTS_HASHTAGS=#gta6 #gtavi #gaming #twitch
# Integrated loudness target. Platforms normalise near -14 LUFS.
SHORTS_LUFS=-14
