# Twitch app credentials — https://dev.twitch.tv/console/apps
# Register an app (OAuth redirect http://localhost, category "Application Integration")
# and paste the Client ID and a generated Client Secret here.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Which Twitch category to watch. Resolved to an id at startup, so this is the
# only thing you change to point the whole feed at a different game.
GAME_NAME=Grand Theft Auto VI

# Optional: skip name resolution by pinning the category id directly.
GAME_ID=

# How far back to look for clips, in minutes. Shorter = fresher and cheaper,
# but moments drop off the feed sooner.
CLIP_WINDOW_MINUTES=25

# Seconds between clip polls. 30 is responsive without burning rate limit.
CLIP_POLL_SECONDS=30

# Max pages of 100 clips per poll. Raise if the feed reports truncation.
CLIP_MAX_PAGES=30

# Seconds between live-channel refreshes (also updates the chat watch list).
STREAM_POLL_SECONDS=120

# Clips within this many seconds of each other count as the same moment.
CLUSTER_GAP_SECONDS=30

# Deep links start this many seconds early, because chat reacts after the
# thing happens and so do clippers.
LEAD_IN_SECONDS=20

# How many top channels to watch chat on. Each socket carries 18 channels.
CHAT_CHANNELS=80

# Set to false to run on clip data alone (no IRC connections).
CHAT_ENABLED=true

PORT=3000
